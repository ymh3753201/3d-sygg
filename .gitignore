# Track maintainable skill sources only; retain all local production artifacts.
/*
!/.gitignore
!/.agents/
/.agents/*
!/.agents/skills/
/.agents/skills/*
!/.agents/skills/3d-sygg/
/.agents/skills/3d-sygg/*
!/.agents/skills/3d-sygg/SKILL.md
!/.agents/skills/3d-sygg/scripts/
!/.agents/skills/3d-sygg/tests/
!/.agents/skills/3d-sygg/references/
!/.agents/skills/3d-sygg/agents/
!/.agents/skills/3d-sygg/config/
!/.agents/skills/3d-sygg/reports/
**/__pycache__/
**/*.pyc
**/.DS_Store
**/.env*
**/config.local.json
**/image.local.json

# Public documentation and release tooling
!/README.md
!/LICENSE
!/CHANGELOG.md
!/CONTRIBUTING.md
!/SECURITY.md
!/docs/
!/tools/
!/.github/
**/outputs/
**/inputs/
**/private/
**/dist/
